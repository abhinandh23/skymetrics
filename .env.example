# Copy this file to .env (same folder) and fill in the values.

# MongoDB Atlas connection string (free M0 cluster is enough).
# Include the database name, e.g. mongodb+srv://user:pass@cluster0.xxxx.mongodb.net/skymetrics?retryWrites=true&w=majority
MONGODB_URI=

# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Gemini model id (see https://ai.google.dev/gemini-api/docs/models)
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: abort Gemini requests after this many milliseconds
GEMINI_TIMEOUT_MS=45000

# Secret used to sign JWTs. Generate one with: openssl rand -hex 32
JWT_SECRET=

# Optional
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_DB=skymetrics
